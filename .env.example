LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
PORT=3001
DATABASE_PATH=./data/memory.sqlite


# Optional Qwen setting. Uses extra_body for OpenAI-compatible proxies.
LLM_DISABLE_THINKING=false
# Optional per-worker overrides; otherwise all use LLM_MODEL.
LLM_VOICE_MODEL=
LLM_DESIGN_MODEL=
